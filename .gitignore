# Secrets. Never commit these.
.env
.env.*
!.env.example
!**/.env.example
infra/.env
app/.env.local

# Private keys and certificates. SafeLine stores the live copies in SAFELINE_DIR.
*.pem
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx

# Dependencies and build output
node_modules/
app/.next/
app/out/
app/coverage/
*.lcov
supabase/functions/coverage/
supabase/functions/cov/

# Local data volumes
infra/volumes/

# Tooling caches
.sonar/
.scannerwork/
coverage/
*.tsbuildinfo
.DS_Store

# Local agent scratch (task briefs, review diffs)
.superpowers/
